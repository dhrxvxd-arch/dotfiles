
#!/usr/bin/env bash

INTERFACE="${BLOCK_INSTANCE:-wlo1}"

case "$BLOCK_BUTTON" in
    1) kitty -e nmtui >/dev/null 2>&1 & ;;
    3) nmcli networking connectivity check >/dev/null 2>&1 ;;
esac

if ! [[ -d "/sys/class/net/$INTERFACE/wireless" ]]; then
    echo "󰖪  No Wi-Fi"
    echo
    echo "#f38ba8"
    exit
fi

wifi=$(nmcli -t -f IN-USE,SSID,SIGNAL dev wifi 2>/dev/null |
    awk -F: '$1 == "*" { print $2 "|" $3; exit }')

if [[ -z "$wifi" ]]; then
    echo "󰖪  Disconnected"
    echo
    echo "#f38ba8"
    exit
fi

ssid="${wifi%|*}"
quality="${wifi##*|}"

if (( quality >= 75 )); then
    color="#b8bb26"
    icon="󰤨"
elif (( quality >= 45 )); then
    color="#fabd2f"
    icon="󰤥"
else
    color="#fb4934"
    icon="󰤟"
fi

printf '%s  %s  %s%% \n\n%s\n' \
    "$icon" "$ssid" "$quality" "$color"

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/src/*.png",
    "height": 12
  },

  "display": {
    "separator": " -> "
  },

  "modules": [
    {
      "type": "title",
      "format": "{6}{7}{8}"
    },
    {
      "type": "custom",
      "format": " ────────────────── "
    },
    {
      "type": "os",
      "key": "󰣇 "
    },
    {
      "type": "kernel",
      "key": " "
    },
    {
      "type": "wm",
      "key": " "
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "format": "{1} / {2}"
    },
    {
      "type": "uptime",
      "key": "󰔛 "
    },
    {
      "type": "custom",
      "format": " ────────────────── "
    }
  ]
}

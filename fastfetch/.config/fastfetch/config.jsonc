{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 1
    }
  },

  "display": {
    "separator": " -> "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "keyWidth": 10,
      "format": "         {6}{7}{8}"
    },

    {
      "type": "custom",
      "format": " ─────────────────────────── "
    },

    {
      "type": "os",
      "key": "󰣇 ",
      "keyColor": "cyan"
    },

    {
      "type": "kernel",
      "key": " ",
      "keyColor": "yellow"
    },

    {
      "type": "wm",
      "key": " ",
      "keyColor": "magenta"
    },

    {
      "type": "shell",
      "key": " ",
      "keyColor": "yellow"
    },

    {
      "type": "terminal",
      "key": " ",
      "keyColor": "blue"
    },

    {
      "type": "cpu",
      "key": "󰻠 ",
      "keyColor": "red"
    },

    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "green"
    },

    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "magenta",
      "format": "{1} / {2}"
    },

    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "cyan"
    },

    {
      "type": "uptime",
      "key": "󰔛 ",
      "keyColor": "green"
    },

    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "yellow"
    },

    {
      "type": "command",
      "key": "󱦟 ",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },

    {
      "type": "custom",
      "format": " ─────────────────────────── "
    },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": ""
    },

    "break"
  ]
}
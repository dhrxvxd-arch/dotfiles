#!/bin/bash

device_num=0
percent="$(amixer -c "$device_num" -M -D default get Master | grep -o -E [[:digit:]]+% | head -n 1)"
percent=${percent::-1}
if [ "$(amixer -c "$device_num" -M -D default get Master | grep off)" != "" ]; then
	echo " 0%"
else
	echo "  $percent%"
fi

case $BLOCK_BUTTON in
  1) pavucontrol --class floater;;
  2) ;;
  3) amixer -q sset Master,0 toggle ;;
  4) amixer -q sset Master,0 5%+ unmute;;
  5) amixer -q sset Master,0 5%- unmute;;
esac

@import "theme.rasi"

#window {
  padding: 5;
}

#mainbox {
  border: 0;
  padding: 5;
}

#message {
  border: 1px dash 0px 0px;
  padding: 1px;
}

#listview {
  fixed-height: 0;
  border: 2px dash 0px 0px;
  spacing: 2px;
  scrollbar: false;
  padding: 2px 0px 0px;
}

#element {
  border: 0;
  padding: 1px;
}

#scrollbar {
  width: 2px;
  border: 0;
  handle-width: 8px;
  padding: 0;
}

#sidebar {
  border: 2px dash 0px 0px;
}

#inputbar {
  spacing: 0;
  padding: 1px;
  children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

#case-indicator {
  spacing: 0;
}

#entry {
  spacing: 0;
}

#prompt {
  spacing: 0;
}

#textbox-prompt-colon {
  expand: false;
  str: ":";
  margin: 0px 0.3em 0em 0em;
}


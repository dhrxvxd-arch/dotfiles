#!/usr/bin/env bash

MOUNT="${BLOCK_INSTANCE:-/home}"

read -r used total percent < <(
    df -P "$MOUNT" | awk 'NR == 2 {
        printf "%dG %dG %d\n",
        $3 / 1048576, $2 / 1048576, $5
    }'
)

if (( percent >= 90 )); then
    color="#fb4934"
elif (( percent >= 75 )); then
    color="#fabd2f"
else
    color="#b8bb26"
fi

echo "  HD /home ${used}/${total}"
